# LLMcut — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
#
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# .env.local is listed in .gitignore and will not be tracked by Git.
# ============================================================

# ----------------------------------------------------------
# Supabase (required for authentication and database)
#
# Find both values in:
#   Supabase Dashboard -> Project Settings -> API
#
# VITE_SUPABASE_URL   : Project URL (e.g. https://<ref>.supabase.co)
# VITE_SUPABASE_PUBLISHABLE_KEY : "Publishable" API key
#
# The publishable key is INTENTIONALLY PUBLIC — it is safe to
# expose in browser bundles. Supabase Row-Level Security (RLS)
# enforces data isolation, not the key itself.
#
# NEVER use the secret "service_role" key here. That key bypasses
# RLS entirely and must only be used in trusted server-side code.
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ----------------------------------------------------------
# Production server (Railway / Node.js static server)
#
# PORT is set automatically by Railway — do not set it manually
# in Railway's variables panel. For local preview only.
#
# HOST should be 0.0.0.0 so the container's port is reachable.
# NODE_ENV is set to "production" automatically by Railway.
# ----------------------------------------------------------
PORT=4173
HOST=0.0.0.0
NODE_ENV=production

# ----------------------------------------------------------
# AI provider keys (optional — for future server-side workers)
#
# These are NOT used by the frontend build today. They are
# documented here for the planned AI clip-extraction worker.
# Add them only when a backend worker is implemented.
# ----------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------------------
# Local API server port (optional — dev only)
#
# Used by `npm run api` to start the SQLite-backed dev server.
# Defaults to 3001 if not set.
# ----------------------------------------------------------
# API_PORT=3001
